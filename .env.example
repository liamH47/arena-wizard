# Arena Wizard environment variables.
#
# Read by the web app through arena_wizard.config.Settings; the CLI reads only
# ARENA_WIZARD_DATA_DIR and ARENA_WIZARD_CACHE_DIR. Copy to .env for local development;
# never commit .env. In production they live in Render's environment.

# dev | prod. prod refuses to boot without Google auth and a Postgres URL (the refresh
# token joins the list with the refresh endpoint in milestone 4).
# ARENA_WIZARD_ENV=dev

# off | google. google requires every GOOGLE_* variable below; the app names what is missing.
# ARENA_WIZARD_AUTH=off

# From console.cloud.google.com, Credentials, OAuth client ID, Web application.
# ARENA_WIZARD_GOOGLE_CLIENT_ID=
# ARENA_WIZARD_GOOGLE_CLIENT_SECRET=

# Signs session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ARENA_WIZARD_SECRET_KEY=

# The public origin. Register <PUBLIC_URL>/auth/google/callback with Google. Its scheme
# decides whether cookies are Secure. Local development: http://localhost:5173
# ARENA_WIZARD_PUBLIC_URL=http://localhost:5173

# The owner's Google email: may delete any friend's paste. Required with google auth.
# ARENA_WIZARD_OWNER_EMAIL=

# Comma-separated Google emails allowed to sign in. Everyone else is turned away.
# ARENA_WIZARD_ALLOWED_EMAILS=

# Neon's pooled connection string in production (postgresql://...-pooler...). Locally the
# default is SQLite inside ARENA_WIZARD_DATA_DIR, never inside the repository.
# ARENA_WIZARD_DATABASE_URL=

# Shared secret the scheduled GitHub workflow sends to POST /api/refresh.
# ARENA_WIZARD_REFRESH_TOKEN=
